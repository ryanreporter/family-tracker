# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
TIMEZONE=America/Chicago

# Where the SQLite database file lives. On Render/Railway point this at your
# persistent disk/volume mount path, e.g. /data/family-tracker.db
DATABASE_PATH=./data/family-tracker.db

# --- Twilio (SMS in/out) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Anthropic (parses incoming texts into structured data) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- USDA FoodData Central (calorie lookups) ---
# Free instant key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# --- The two people who can text in/out ---
JOE_NAME=Joe
JOE_PHONE=+17735316716
HILLARY_NAME=Hillary
HILLARY_PHONE=+17089513283

# --- Dashboard login (HTTP Basic Auth) ---
DASHBOARD_USER=family
DASHBOARD_PASS=change-me
